# Ritiri Itineranti · GreenGeeks (Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Forza HTTPS e il dominio senza www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://ritiriitineranti.it/$1 [L,R=301]

# Indirizzi puliti senza .html
# /pagina.html -> /pagina (redirect permanente), /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$
RewriteRule ^ /%1 [R=301,L]
# /pagina serve il file pagina.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Blocca i file del repository
RedirectMatch 404 /\.git
<FilesMatch "^(README\.md|SEO\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

# Compressione e cache
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
